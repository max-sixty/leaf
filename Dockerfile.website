FROM node:22-bookworm-slim AS codex

WORKDIR /codex
COPY worker/package.json worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && mkdir /codex-bin \
    && cp node_modules/@openai/codex-linux-*/vendor/*/bin/codex /codex-bin/codex \
    && cp node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host /codex-bin/codex-code-mode-host \
    && cp node_modules/@openai/codex-linux-*/vendor/*/codex-path/rg /codex-bin/rg \
    && cp -R node_modules/@openai/codex-linux-*/vendor/*/codex-resources /codex-bin/codex-resources \
    && test -x /codex-bin/codex-resources/bwrap

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    LEAF_SITE_ROOT=/app/site \
    CODEX_HOME=/app/.codex \
    PATH=/codex-bin:/app/.venv/bin:$PATH

COPY --from=codex /codex-bin /codex-bin
RUN ln -s /codex-bin/rg /usr/local/bin/rg

# Leaf and its website server come from the installation `leaf-dev site` built its pages
# with, a prepared one, so a revision a hosted session writes carries the same compiled
# kernel as a consumer install.
COPY .tmp/site-install/pyproject.toml .tmp/site-install/uv.lock \
    .tmp/site-install/leaf-distribution.json ./
COPY .tmp/site-install/skills/leaf ./skills/leaf
COPY .tmp/site-install/worker ./worker
RUN uv sync --frozen --no-dev --package leaf-website --compile-bytecode \
    && /app/.venv/bin/python -m compileall -q /app/skills/leaf/scripts/leaf \
    && /app/.venv/bin/leaf --version \
    && ln -s /app/.venv/bin/leaf /usr/local/bin/leaf

COPY worker/codex-config.toml /app/.codex/config.toml

COPY .tmp/site ./site

EXPOSE 8080
CMD ["/app/.venv/bin/python", "-m", "leaf_website"]
