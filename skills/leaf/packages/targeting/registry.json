{
  "lf-targeting": {
    "description": "A workbench for selecting parts of an authored preview and submitting exact style or prose changes.",
    "x-instructions": "Use lf-ask to frame the question and context when they live outside the workbench. Supply one real lf-target-preview.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "submit-label": {
        "type": "string",
        "minLength": 1
      },
      "restated": {
        "type": "boolean"
      }
    },
    "required": ["id"],
    "additionalProperties": false,
    "x-content": "members",
    "x-upgrade": true,
    "x-awaits": {
      "answered": {"submit": {}}
    },
    "x-state": {
      "submit": {
        "detail": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^target-[1-9][0-9]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": ["element", "class"]
                  },
                  "className": {
                    "type": ["string", "null"]
                  },
                  "reference": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "id"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["kind", "id"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "structure"
                          },
                          "anchor": {
                            "type": "string",
                            "minLength": 1
                          },
                          "path": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "tree": {
                                  "enum": ["light", "shadow"]
                                },
                                "tag": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9-]*$"
                                }
                              },
                              "required": ["tree", "tag"],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": ["kind", "path"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "name",
                  "scope",
                  "className",
                  "reference",
                  "label",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^change-[1-9][0-9]*$"
                      },
                      "target": {
                        "type": "string",
                        "pattern": "^target-[1-9][0-9]*$"
                      },
                      "kind": {
                        "const": "style"
                      },
                      "property": {
                        "enum": [
                          "padding",
                          "margin",
                          "gap",
                          "border-width",
                          "border-radius",
                          "width",
                          "min-height"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?px$"
                      }
                    },
                    "required": ["id", "target", "kind", "property", "value"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^change-[1-9][0-9]*$"
                      },
                      "target": {
                        "type": "string",
                        "pattern": "^target-[1-9][0-9]*$"
                      },
                      "kind": {
                        "const": "instruction"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["id", "target", "kind", "text"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": ["targets", "changes"],
          "additionalProperties": false
        },
        "unit": "widget"
      }
    },
    "x-height": true,
    "x-example": "<lf-ask id=\"landing-change-ask\"><h2>Which landing-page changes should the agent make?</h2><lf-targeting id=\"landing-targeting\"><lf-target-preview id=\"landing-preview\"><section id=\"hero\" class=\"landing-section\"><h3 class=\"section-title\">Build the next release</h3><p>Keep the request path visible.</p><button type=\"button\">Start review</button></section><section class=\"landing-section\"><h3 class=\"section-title\">Inspect the evidence</h3></section></lf-target-preview></lf-targeting></lf-ask>"
  },
  "lf-target-preview": {
    "description": "The authored markup a targeting workbench lets the user select and adjust.",
    "x-instructions": "Use stable authored ids for targets that should retain identity across revisions. Visible labels and context describe a target; they do not identify it.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "required": ["id"],
    "additionalProperties": false,
    "x-owners": ["lf-targeting"],
    "x-content": "markup",
    "x-upgrade": false
  }
}
