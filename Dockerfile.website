FROM node:22-bookworm-slim AS codex

WORKDIR /codex
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN npm install --global "$(node -p 'require("./package.json").packageManager')" \
    && pnpm install --prod --frozen-lockfile --ignore-scripts \
    && codex_vendor="$(node -e 'const { createRequire } = require("node:module"); const { dirname } = require("node:path"); const codex = createRequire(require.resolve("@openai/codex/package.json")); process.stdout.write(dirname(codex.resolve(`@openai/codex-linux-${process.arch}/package.json`)) + "/vendor")')" \
    && mkdir /codex-bin \
    && cp "$codex_vendor"/*/bin/codex /codex-bin/codex \
    && cp "$codex_vendor"/*/bin/codex-code-mode-host /codex-bin/codex-code-mode-host \
    && cp "$codex_vendor"/*/codex-path/rg /codex-bin/rg \
    && cp -R "$codex_vendor"/*/codex-resources /codex-bin/codex-resources \
    && test -x /codex-bin/codex-resources/bwrap

FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    LEAF_SITE_ROOT=/app/site \
    CODEX_HOME=/codex-home \
    PATH=/codex-bin:/app/.venv/bin:$PATH

COPY --from=codex /codex-bin /codex-bin
RUN ln -s /codex-bin/rg /usr/local/bin/rg

# Leaf and its website server come from the installation `leaf-dev site` built its pages
# with, a prepared one, so a revision a hosted session writes carries the same compiled
# kernel as a consumer install.
COPY .tmp/site-install/ ./
# Install the complete prepared plugin before uv creates an environment in this
# payload: Codex's native installer copies it into the ordinary plugin cache.
COPY worker/codex-config.toml /codex-home/config.toml
RUN codex plugin marketplace add /app --json \
    && codex plugin add leaf@leaf --json
RUN uv sync --frozen --no-dev --package leaf-website --compile-bytecode \
    && /app/.venv/bin/python -m compileall -q /app/skills/leaf/scripts/leaf \
    && /app/.venv/bin/leaf --version \
    && ln -s /app/.venv/bin/leaf /usr/local/bin/leaf

COPY .tmp/site ./site

EXPOSE 8080
CMD ["/app/.venv/bin/python", "-m", "leaf_website"]
