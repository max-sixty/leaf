{
  "name": "leaf-browser-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": ["./hooks/pi.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "build:browser": "node build/browser/build.mjs",
    "check:browser": "node build/browser/build.mjs --check",
    "test:browser": "node --test build/browser/*.test.mjs",
    "test:runtime": "node --import ./tests/runtime/dom.mjs --test tests/runtime/*.test.mjs"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@floating-ui/dom": "1.8.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@observablehq/plot": "0.6.17",
    "@pierre/diffs": "1.5.1",
    "@preact/signals-core": "1.14.4",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "acorn": "8.18.0",
    "agentic-mermaid": "0.4.1",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "highlight.js": "11.12.0",
    "lit": "3.3.3",
    "lit-html": "3.3.3",
    "marked": "18.0.14",
    "sortablejs": "1.15.7",
    "typescript": "7.0.2"
  }
}
