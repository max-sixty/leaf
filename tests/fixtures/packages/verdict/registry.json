{
  "$data": {
    "contracts": {
      "verdict-notes": {
        "description": "A short note for each choice of a verdict, keyed by the choice's value.",
        "schema": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "lf-verdict": {
    "description": "A ship-or-hold decision on a release, each choice a comment target. Put it in an `lf-group` whose label asks the question.",
    "attributes": {
      "properties": {
        "verdict": { "type": "string", "enum": ["ship", "hold"] }
      },
      "required": ["id"]
    },
    "content": "empty",
    "verbs": {
      "decide": {
        "record": { "attr": "verdict" }
      }
    },
    "awaits": { "value": "decide" },
    "facts": { "answered": { "type": "boolean" } },
    "visual": { "prefixes": ["choice:"] },
    "inputs": {
      "notes": {
        "contract": "verdict-notes",
        "source": "source",
        "property": "notes"
      }
    },
    "example": "<lf-group id=\"release\" label=\"Ship 4.2 today?\"><lf-verdict id=\"release-verdict\"></lf-verdict></lf-group>"
  }
}
