{
  "$data": {
    "contracts": {
      "shortlist": {
        "description": "The candidates a shortlist holds, in its order, and which of them are picked.",
        "commands": {
          "--toggle": "Picks the candidate whose `key` is the button's `value`, or drops it where it is picked."
        },
        "instructions": {
          "producer": "Hold the value again after every change, whoever asked for it."
        },
        "schema": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "picked": {
                    "type": "boolean"
                  }
                },
                "required": ["key", "name", "picked"],
                "additionalProperties": false
              }
            }
          },
          "required": ["candidates"],
          "additionalProperties": false
        }
      }
    }
  },
  "lf-shortlist": {
    "description": "A list of candidates the user picks from, each pick recorded on its own. It holds the list and its picks as its `shortlist` output.",
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "verbs": {
      "pick": {
        "unit": "candidate",
        "detail": {
          "type": "object",
          "properties": {
            "candidate": {
              "type": "string",
              "minLength": 1
            },
            "picked": {
              "type": "boolean"
            }
          },
          "required": ["candidate", "picked"],
          "additionalProperties": false
        }
      }
    },
    "outputs": {
      "shortlist": {
        "contract": "shortlist"
      }
    },
    "example": "<lf-shortlist id=\"hires\"><ul><li><button type=\"button\" commandfor=\"hires\" command=\"--toggle\" value=\"ada\">Ada Lovelace</button></li><li><button type=\"button\" commandfor=\"hires\" command=\"--toggle\" value=\"grace\">Grace Hopper</button></li></ul></lf-shortlist>",
    "instructions": "Write one <ul> with an <li> per candidate, each holding a <button type=\"button\" commandfor=\"THIS-ID\" command=\"--toggle\" value=\"KEY\"> whose words name the candidate."
  }
}
