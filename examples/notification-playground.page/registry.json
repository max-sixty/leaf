{
  "$data": {
    "contracts": {
      "notification-playground-values": {
        "description": "The deployment-notification playground with one exact scalar configuration.",
        "schema": {
          "type": "object",
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "compact": {
              "type": "boolean"
            },
            "format": {
              "enum": ["banner", "status strip"]
            },
            "tone": {
              "enum": ["calm", "urgent"]
            },
            "show-owner": {
              "type": "boolean"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "events",
            "radius",
            "compact",
            "format",
            "tone",
            "show-owner",
            "accent",
            "title"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
