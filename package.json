{
  "name": "leaf-browser-build",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:browser": "node scripts/browser/build.mjs",
    "check:browser": "node scripts/browser/build.mjs --check",
