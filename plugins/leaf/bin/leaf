#!/bin/sh
# The one entry point. Claude Code appends every enabled plugin's bin/ to PATH;
# Codex resolves this launcher from the active skill directory.
#
# Two subcommands open a browser: `version check --render` looks at the page and
# `version export` copies it. Both need Playwright, and declaring it in the script's
# PEP 723 header would put its wheel behind every `server run`, `leaf wait`, and
# `version publish`, so it is supplied here on exactly the invocations that launch
# Chrome. It sits outside the script's lock as a result, so these two runs pin
# everything else and take whatever Playwright resolves.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script=$root/skills/leaf/scripts/interact.py

# Codex exposes the thread id to shell tools. Carry it into the same session
# record Claude Code supplies directly. The name is a default, not the last word:
# a worker session launched with its own LEAF_AGENT keeps that voice.
#
# The id and the name are the whole of it, because they are the whole of what a
# launcher knows. Which process the session *is* — the one whose death stops the
# page's server — is not $PPID: that is whatever the shape of the command left
# above leaf, the codex process where the wrapping shell could exec leaf in its
# place and a shell of the moment where a pipeline stopped it. The second exits
# with the command and the page's server goes down behind it, so `session_pid`
# walks for the process from inside the script instead.
if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -n "${CODEX_THREAD_ID:-}" ]; then
  export LEAF_SESSION_ID=$CODEX_THREAD_ID
  export LEAF_AGENT=${LEAF_AGENT:-Codex}
fi

# The lock beside the script records an absolute pypi.org URL per wheel, and uv
# fetches exactly those, so an index the host configures is never consulted while
# the lock can be served. On a host whose index is a private mirror that fetch
# fails, and it fails before the script runs — every command, not one of them. So
# the install is asked for first, and where the lock cannot be served the run
# resolves the header itself against whatever index the host has. `--upgrade` is
# the one thing that reaches past the lock's pins: an index flag, a refresh flag
# and the index variables do not. It rewrites the lock to what it resolved, so a
# mirror host pays that resolve once and pins again afterwards.
#
# The ask costs a few milliseconds where the wheels are already there, which is
# every host that was working before, and it is silent because the run behind it
# reports whatever it hits.
resolve=
uv sync --script "$script" >/dev/null 2>&1 || resolve=--upgrade

if [ "${1-}" = "version" ] && [ "${2-}" = "export" ]; then
  exec uv run $resolve --with playwright "$script" "$@"
fi

if [ "${1-}" = "version" ] && [ "${2-}" = "check" ]; then
  for cli_arg in "$@"; do
    if [ "$cli_arg" = "--render" ]; then
      exec uv run $resolve --with playwright "$script" "$@"
    fi
  done
fi
exec uv run $resolve "$script" "$@"
