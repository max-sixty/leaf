#!/bin/sh
# The one launcher. Claude Code appends plugin bin/ directories to its Bash tool's
# PATH; hooks and Codex resolve this launcher from the plugin or skill directory.
#
# A host selects its executable with an absolute LEAF_HOST_LAUNCHER path for
# commands and native hooks, while SessionEnd keeps standalone cleanup below.
# A redirected call consumes the selection so a host wrapper can invoke Leaf.
# Selecting this launcher itself leaves the default dispatch.
#
# By default the directory above it is a uv project — the repository and the
# installed plugin are the same tree — and this runs that project's environment,
# which uv keeps one of per installed version and syncs in place on first use.
# `--no-dev` because the project's dev group is the test suite and the
# `leaf-dev` tooling, recorded in the shipped lock but never a harness's to
# install. `--inexact`, as `uv run` syncs, so a checkout's dev tools stay. `-q`
# because an agent reads stderr back and an ordinary sync has nothing to say; a
# failed resolve is reported either way.
#
# Once uv has synced the environment, Leaf runs on its interpreter directly:
# `uv run` costs about 70 ms more on every command and hook even with nothing to
# sync (measured on macOS), and one reply runs dozens of them. The environment
# keeps a mark of its last sync (`leaf-synced`), naming the tree it was synced
# for, since an install that copies a checkout copies its environment too. A
# lock or project file changed since, as a plugin update or a checkout makes, a
# missing interpreter, or a mark naming another tree has uv sync it first. The
# mark must be newer than both files, so a change in the same second as a sync
# only costs one more sync.
#
# The module rather than the `leaf` console script: where this path is long
# enough to pass the ~127-byte shebang limit — a harness cache path reaches it —
# uv writes the console script as a `/bin/sh` trampoline, and `-m` leaves no
# trampoline to reason about. `__main__.py` fixes `prog_name`, so usage lines
# still read `leaf`. Which harness session is running, and under what id, is the
# hook registration's and payload's to say, or a shell command's environment's
# (`harness.py`), never this launcher's.
# SessionEnd must release claims within the harness's shutdown deadline even before
# this install has an environment. Its canonical cleanup is a standalone stdlib
# Python 3.9 program; it never imports the managed Leaf package.
#
# Codex runs its tool hook after every tool call, and Claude Code its prompt and
# Stop hooks in every session the plugin is installed in, and these have nothing to
# do in a session that holds no claim. Each such registration says so
# (`hook --harness NAME --if-claimed`), so where the environment exists the hook
# first asks the same standalone program, on that environment's interpreter,
# whether the session holds one (`state.holds_claims`). That spares the package's
# imports wherever no page was claimed. It answers a Claude Code tool boundary
# that would read what the last quiet one read the same way
# (`state.boundary_quiet`). Without the environment, or with any answer but
# "nothing", the hook runs whole.
#
# Claude Code's sandbox refuses what a command needs, so where it confines this
# one (SANDBOX_RUNTIME), the bridge Leaf's hooks keep outside it runs the command
# (`bridge.py`). `-I` keeps the agent's directory off the module path.
#
# uv's cache serves only to fill the environment, yet `uv sync` opens it even
# with nothing to fetch, and Codex's sandbox refuses writes to ~/.cache/uv. So
# once the environment exists, which the first hook ensures outside any sandbox,
# uv runs without the cache; a sync a changed lock needs then downloads afresh.
# The flag is not inherited, so `package run`'s own uv keeps the cache.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
state="$root/src/leaf/state.py"
if [ "$#" -eq 1 ] && [ "$1" = session-end ]; then
    exec python3 -S "$state"
fi
cache=
[ -d "$root/.venv" ] && cache=--no-cache
case "${LEAF_HOST_LAUNCHER:-}" in
    ''|/*) ;;
    *) printf '%s\n' 'LEAF_HOST_LAUNCHER must name an absolute launcher path' >&2; exit 2 ;;
esac
if [ -n "${LEAF_HOST_LAUNCHER:-}" ] && [ ! "$LEAF_HOST_LAUNCHER" -ef "$0" ]; then
    leaf_host_launcher=$LEAF_HOST_LAUNCHER
    unset LEAF_HOST_LAUNCHER
    exec "$leaf_host_launcher" "$@"
fi
python="$root/.venv/bin/python"
if [ -n "${SANDBOX_RUNTIME:-}" ] && [ -x "$python" ]; then
    exec "$python" -I -m leaf.bridge run "$@"
fi
synced="$root/.venv/leaf-synced"
ensure_synced() {
    marked=
    [ -f "$synced" ] && read -r marked <"$synced"
    if ! { [ "$marked" = "$root" ] && [ -x "$python" ] &&
        [ "$synced" -nt "$root/uv.lock" ] && [ "$synced" -nt "$root/pyproject.toml" ]; }; then
        uv sync -q $cache --no-dev --inexact --project "$root" </dev/null || exit
        printf '%s\n' "$root" >"$synced"
    fi
}
if [ "${1:-}" = hook ] && [ "${4:-}" = --if-claimed ] && [ -x "$python" ]; then
    payload=$(cat)
    printf '%s' "$payload" | "$python" -S "$state" hook-gate
    [ "$?" -eq 3 ] && exit 0
    ensure_synced
    exec "$python" -m leaf "$@" <<EOF
$payload
EOF
fi
ensure_synced
exec "$python" -m leaf "$@"
