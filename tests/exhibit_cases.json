{
  "registry": {
    "lf-sample": {
      "x-exhibit": {
        "when": {
          "interactive": [false]
        }
      }
    },
    "lf-group": {},
    "lf-pick": {},
    "lf-quote": {
      "x-exhibit": true
    }
  },
  "cases": [
    {
      "id": "a widget inside an exhibit is quoted and the exhibit is not",
      "markup": "<lf-sample id=\"exhibit\"><lf-pick id=\"inner\"></lf-pick></lf-sample>",
      "quoted": {
        "exhibit": false,
        "inner": true
      }
    },
    {
      "id": "plain markup between them does not lift the fence",
      "markup": "<lf-sample id=\"exhibit\"><div><p><lf-pick id=\"inner\"></lf-pick></p></div></lf-sample>",
      "quoted": {
        "exhibit": false,
        "inner": true
      }
    },
    {
      "id": "a widget between them is quoted, and so is what it holds",
      "markup": "<lf-sample id=\"exhibit\"><lf-group id=\"group\"><lf-pick id=\"inner\"></lf-pick></lf-group></lf-sample>",
      "quoted": {
        "exhibit": false,
        "group": true,
        "inner": true
      }
    },
    {
      "id": "a widget beside an exhibit is not quoted",
      "markup": "<lf-sample id=\"exhibit\"></lf-sample><lf-pick id=\"beside\"></lf-pick>",
      "quoted": {
        "exhibit": false,
        "beside": false
      }
    },
    {
      "id": "an exhibit inside an exhibit is quoted",
      "markup": "<lf-sample id=\"outer\"><lf-sample id=\"inner\"></lf-sample></lf-sample>",
      "quoted": {
        "outer": false,
        "inner": true
      }
    },
    {
      "id": "interactive sample uses the parent page",
      "markup": "<lf-sample id=\"sample\" interactive><lf-pick id=\"pick\"></lf-pick></lf-sample>",
      "quoted": {
        "sample": false,
        "pick": false
      }
    },
    {
      "id": "interactive sample cannot escape an outer quotation",
      "markup": "<lf-quote id=\"outer\"><lf-sample id=\"sample\" interactive><lf-pick id=\"pick\"></lf-pick></lf-sample></lf-quote>",
      "quoted": {
        "outer": false,
        "sample": true,
        "pick": true
      }
    },
    {
      "id": "quotation nested in interactive sample still quotes",
      "markup": "<lf-sample id=\"sample\" interactive><lf-sample id=\"quote\"><lf-pick id=\"pick\"></lf-pick></lf-sample></lf-sample>",
      "quoted": {
        "sample": false,
        "quote": false,
        "pick": true
      }
    }
  ]
}
