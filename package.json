{
  "name": "leaf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./hooks/pi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build:browser": "node build/browser/build.mjs",
    "check:browser": "node build/browser/build.mjs --check",
    "test:browser": "node --test build/browser/*.test.mjs build/*.test.mjs .github/scripts/*.test.mjs",
    "test:runtime": "node --import ./tests/runtime/dom.mjs --test tests/runtime/*.test.mjs",
    "check:framework": "pnpm run check:browser && pnpm run test:browser",
    "check:worker": "tsc --noEmit --project worker/tsconfig.json && pnpm run test:worker",
    "check": "pnpm run check:framework && pnpm run test:runtime && pnpm run check:worker && pnpm run test:evals",
    "test:worker": "vitest run --root worker",
    "test:evals": "node --test evals/test_*.cjs",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1 promptfoo view -y",
    "site:dev": "uv run leaf-dev site && wrangler dev --config worker/wrangler.toml",
    "deploy:dev": "worker/deploy-dev.sh"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@awesome.me/webawesome": "3.14.0",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20261009.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@floating-ui/dom": "1.8.0",
    "@happy-dom/global-registrator": "20.14.6",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@observablehq/plot": "0.6.17",
    "@pierre/diffs": "1.5.2",
    "@preact/signals-core": "1.14.4",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@types/node": "26.6.4",
    "@zumer/snapdom": "3.3.0",
    "acorn": "8.19.0",
    "amaro": "1.2.1",
    "d3": "7.9.0",
    "density-clustering": "1.3.0",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "lit": "3.3.3",
    "lit-html": "3.3.0",
    "markdown-it": "15.0.2",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.2.0",
    "modern-screenshot": "4.7.0",
    "modern-tar": "0.8.5",
    "oxc-parser": "0.153.0",
    "photoswipe": "5.4.4",
    "playwright": "1.64.0",
    "promptfoo": "0.124.1",
    "smol-toml": "1.9.0",
    "sortablejs": "1.15.7",
    "typescript": "7.0.2",
    "uuid": "14.0.2",
    "viewerjs": "1.15.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@openai/codex": "0.162.0"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk": "$@anthropic-ai/claude-agent-sdk",
      "lit-html": "$lit-html",
      "get-uri>basic-ftp": "6.2.1"
    }
  }
}
