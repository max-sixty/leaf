{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook 2>/dev/null || true",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "[ -z \"$CLAUDECODE\" ] || exec python3 \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/loop-guard.py\" --watch",
            "asyncRewake": true,
            "rewakeMessage": "Leaf:",
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
