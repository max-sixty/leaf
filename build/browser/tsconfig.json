{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Array", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "paths": {
      "/vendor/browser-runtime.js": ["./index.ts"],
      "/vendor/*": [
        "../../skills/leaf/assets/vendor/*",
        "../../skills/leaf/packages/default/vendor/*",
        "../../skills/leaf/packages/diagram/vendor/*",
        "../../skills/leaf/packages/diff/vendor/*",
        "../../skills/leaf/packages/file-editor/vendor/*",
        "../../skills/leaf/packages/playwright/vendor/*"
      ],
      "/widgets/*": [
        "../../skills/leaf/assets/widgets/*",
        "../../skills/leaf/packages/default/widgets/*"
      ],
      "/runtime/*": ["../../skills/leaf/assets/runtime/*"],
      "/checks/*": ["../../skills/leaf/scripts/leaf/render-checks/*"]
    }
  },
  "include": ["*.ts", "../../skills/leaf/assets/runtime/**/*.js"]
}
