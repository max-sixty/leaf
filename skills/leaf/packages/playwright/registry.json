                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "box": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/box"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
