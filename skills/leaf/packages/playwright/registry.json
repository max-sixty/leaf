          "type": "object",
          "properties": {
            "archive": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "format": {
                  "const": 9
                }
              },
              "required": [
                "sha256",
                "format"
              ],
              "additionalProperties": false
            },
            "viewerUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://\\S+$"
            },
            "streams": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stream"
              }
            },
            "pages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/page"
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/action"
              }
            },
            "images": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/image"
              }
            }
          },
          "required": [
            "archive",
            "viewerUrl",
            "streams",
            "pages",
            "actions",
            "images"
          ],
          "additionalProperties": false,
          "$defs": {
            "box": {
