+/**
+ * The source text this renderer would not read, for the grammars whose parsers
+ * report it — flowcharts and state diagrams. One entry per statement the parser
+ * stopped reading before. An empty list means every statement was read whole; it
+ * does not mean the drawing is the one the author had in mind.
+ */
+export function unreadMermaidText(text: string): string[] {
+  const decoded = decodeXML(text)
+  if (detectDiagramType(decoded) !== 'flowchart') return []
+  return parseMermaid(decoded).unread
+}
+
