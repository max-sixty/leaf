{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "ESNext.TypedArrays",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false,
    "checkJs": true,
    "types": []
  },
  "include": [
    "*.d.ts",
    "domain.test.js",
    "../leaf.js",
    "../runtime/**/*.js",
    "../widgets/*.js",
    "../../packages/*/widgets/**/*.js",
    "../../src/leaf/render-checks/*.js",
    "../../build/entries/**/*.mjs"
  ]
}
