{
  "lf-review-summary": {
    "description": "A review checklist with a recorded pass or fail result, keeping authored evidence and nested widgets readable.",
    "attributes": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restated": {
          "type": "boolean"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "server": {
      "state": {
        "review": {
          "unit": "widget",
          "detail": {
            "type": "object",
            "properties": { "outcome": { "enum": ["pass", "fail"] } },
            "required": ["outcome"],
            "additionalProperties": false
          }
        }
      }
    },
    "author": {
      "example": "<lf-review-summary id=\"review-summary\"><h2>Retry policy review</h2><p>The retry budget permits one retry after the shared refresh completes.</p></lf-review-summary>"
    }
  }
}
