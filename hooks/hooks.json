{
  "modules": ["./claude-code.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(leaf *)",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(*/leaf *)",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(*/leaf)",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code --if-claimed || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^resume$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code --if-claimed || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code --if-claimed || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code --if-claimed || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" session-end || exit 1",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
