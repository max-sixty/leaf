{
  "$data": {
    "description": "Reusable evidence from one guided website visual run.",
    "contracts": {
      "visual-run": {
        "description": "An ordered set of aligned before-and-after website states captured against one base and one candidate.",
        "guidance": {
          "producer": "Capture the same authored journey against immutable base and candidate URLs. Import every image with `leaf page media`, then replace the complete source with `leaf data set`. Each case keeps a stable `id`, a short action and observed result, both image paths, and the browser conditions under which the pair was captured. Use a new source id when the run changes meaning."
        },
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "base": {
              "$ref": "#/$defs/target"
            },
            "candidate": {
              "$ref": "#/$defs/target"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/case"
              }
            }
          },
          "required": [
            "title",
            "observedAt",
            "base",
            "candidate",
            "cases"
          ],
          "additionalProperties": false,
          "$defs": {
            "target": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                }
              },
              "required": [
                "revision",
                "url"
              ],
              "additionalProperties": false
            },
            "capture": {
              "type": "object",
              "properties": {
                "browser": {
                  "type": "string",
                  "minLength": 1
                },
                "browserVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "viewport": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                "deviceScaleFactor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "colorScheme": {
                  "enum": [
                    "light",
                    "dark"
                  ]
                },
                "locale": {
                  "type": "string",
                  "minLength": 1
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "browser",
                "browserVersion",
                "viewport",
                "deviceScaleFactor",
                "colorScheme",
                "locale",
                "timezone"
              ],
              "additionalProperties": false
            },
            "case": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/\\S*$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "type": "string",
                  "minLength": 1
                },
                "classification": {
                  "enum": [
                    "changed",
                    "clean"
                  ]
                },
                "capture": {
                  "$ref": "#/$defs/capture"
                },
                "before": {
                  "type": "string",
                  "pattern": "^/media/\\S+$"
                },
                "after": {
                  "type": "string",
                  "pattern": "^/media/\\S+$"
                },
                "traceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                }
              },
              "required": [
                "id",
                "title",
                "path",
                "action",
                "result",
                "classification",
                "capture",
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "lf-visual-review": {
    "description": "A guided review of one typed visual run. Author an empty element with an id, bind its required `run` input through `source`, and optionally pin an immutable data revision through `snapshot`. The widget keeps compact case navigation above one wide before-and-after comparison with local compare, flip, overlay, fit, and captured-size inspection, opens the exact base and candidate paths, discloses capture provenance after the evidence, records a disposition for each case, and seats case threads beside the selected evidence.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "snapshot": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "required": [
      "id",
      "source"
    ],
    "additionalProperties": false,
    "x-content": "empty",
    "x-data": {
      "run": {
        "contract": "visual-run",
        "source": "source",
        "snapshot": "snapshot"
      }
    },
    "x-guidance": {
      "author": "Bind one empty `lf-visual-review` to a complete visual run. Keep the claim and recommendation in authored prose around it. Pin `snapshot` when the review must remain exact after the source changes."
    },
    "x-state": {
      "review": {
        "detail": {
          "type": "object",
          "properties": {
            "case": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "disposition": {
              "enum": [
                "looks-right",
                "needs-work"
              ]
            }
          },
          "required": [
            "case",
            "disposition"
          ],
          "additionalProperties": false
        },
        "facet": "disposition",
        "unit": "case"
      }
    },
    "x-thread-surface": true,
    "x-upgrade": true,
    "x-wide": "box",
    "x-example": "<lf-visual-review id=\"docs-review\" source=\"docs-visual-run\" snapshot=\"3\"></lf-visual-review>"
  }
}
