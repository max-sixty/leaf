{
  "$data": {
    "contracts": {
      "code-comparison-values": {
        "description": "The built code-reader comparison with explicit candidate configurations.",
        "schema": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 280,
              "maximum": 520
            },
            "chosen": {
              "enum": ["A", "B"]
            },
            "comparison": {
              "type": "object",
              "properties": {
                "candidateA": {
                  "type": "object",
                  "properties": {
                    "density": {
                      "enum": ["compact", "comfortable"]
                    },
                    "wrap": {
                      "type": "boolean"
                    }
                  },
                  "required": ["density", "wrap"],
                  "additionalProperties": false
                },
                "candidateB": {
                  "type": "object",
                  "properties": {
                    "density": {
                      "enum": ["compact", "comfortable"]
                    },
                    "wrap": {
                      "type": "boolean"
                    }
                  },
                  "required": ["density", "wrap"],
                  "additionalProperties": false
                }
              },
              "required": ["candidateA", "candidateB"],
              "additionalProperties": false
            }
          },
          "required": ["width", "chosen", "comparison"],
          "additionalProperties": false
        }
      }
    }
  }
}
