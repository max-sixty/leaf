      "anchor": {
        "section": "s",
        "quote": "AA"
      },
      "before": 2
    },
    {
      "id": "copies that overlap are one, the first",
      "markup": "<p id=\"s\">aaa</p>",
      "anchor": {
        "section": "s",
        "quote": "aa"
      },
      "before": 0
    },
    {
      "id": "two copies past each other are two",
      "markup": "<p id=\"s\">aaaa</p>",
      "anchor": {
        "section": "s",
        "quote": "aa"
      },
      "before": null
    },
    {
