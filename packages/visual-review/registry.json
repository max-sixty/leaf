{
  "$data": {
    "description": "Reusable evidence from one guided website visual run.",
    "contracts": {
      "visual-run": {
        "description": "An ordered set of aligned before-and-after website states captured against one base and one candidate.",
        "instructions": {
          "producer": "Capture the same authored journey at the same viewport against immutable base and candidate revisions. Wait on a product readiness fact, disable animation, and freeze seeded data and time. Include a case's target URL only when its captured revision has a real replayable destination. Authenticate the capture browser rather than the run: store clean target URLs, and never put query keys, cookies or headers into page data or media. Inspect every image for credentials or personal data, import it with `leaf page media`, then replace the complete source with `leaf data set`. Each case keeps a stable `id` across refreshes, a short action and observed result, both image paths, and the browser conditions and `observedAt` under which that pair was captured, so refreshing one case keeps the provenance of the others. When a small change is hard to find in a large capture, give its case one `focus` rectangle, `x`, `y`, `width` and `height` in captured CSS pixels from the image's top-left, shared by both images and inside both, with enough context around it to show displacement. A second area that makes a separate claim is another case reusing the image pair. Use a new source id when the run changes meaning."
        },
        "records": {
          "items": "cases",
          "key": "id"
        },
        "resources": ["cases[].before", "cases[].after"],
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "$ref": "#/$defs/target"
            },
            "candidate": {
              "$ref": "#/$defs/target"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/case"
              }
            }
          },
          "required": ["title", "base", "candidate", "cases"],
          "additionalProperties": false,
          "$defs": {
            "target": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                }
              },
              "required": ["revision"],
              "additionalProperties": false
            },
            "capture": {
              "type": "object",
              "properties": {
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "browser": {
                  "type": "string",
                  "minLength": 1
                },
                "browserVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "viewport": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": ["width", "height"],
                  "additionalProperties": false
                },
                "deviceScaleFactor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "colorScheme": {
                  "enum": ["light", "dark"]
                },
                "locale": {
                  "type": "string",
                  "minLength": 1
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "observedAt",
                "browser",
                "browserVersion",
                "viewport",
                "deviceScaleFactor",
                "colorScheme",
                "locale",
                "timezone"
              ],
              "additionalProperties": false
            },
            "focus": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": ["x", "y", "width", "height"],
              "additionalProperties": false
            },
            "case": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/\\S*$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "type": "string",
                  "minLength": 1
                },
                "classification": {
                  "enum": ["changed", "clean"]
                },
                "capture": {
                  "$ref": "#/$defs/capture"
                },
                "focus": {
                  "$ref": "#/$defs/focus"
                },
                "before": {
                  "type": "string",
                  "pattern": "^/media/\\S+$"
                },
                "after": {
                  "type": "string",
                  "pattern": "^/media/\\S+$"
                },
                "traceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                }
              },
              "required": [
                "id",
                "title",
                "path",
                "action",
                "result",
                "classification",
                "capture",
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "lf-visual-review": {
    "description": "A visual review workspace with before-and-after captures, case approvals and anchored feedback.",
    "x-word": "review",
    "x-instructions": "Write it empty with a stable id, and bind `source` to the visual run. To open a case on its changed area, give it a `focus` rectangle in the run. Tie each case's id to the run, not to the user's inspection choices.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "required": ["id", "source"],
    "additionalProperties": false,
    "x-content": "empty",
    "x-data": {
      "run": {
        "contract": "visual-run",
        "source": "source",
        "property": "value"
      }
    },
    "x-awaits": {
      "records": {
        "input": "run",
        "label": "title"
      },
      "value": "review",
      "answered": {
        "review": {
          "detail": {
            "approved": true
          }
        }
      }
    },
    "x-state": {
      "review": {
        "detail": {
          "type": "object",
          "properties": {
            "case": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "approved": {
              "type": "boolean"
            }
          },
          "required": ["case", "approved"],
          "additionalProperties": false
        },
        "unit": "case"
      }
    },
    "x-thread-surface": true,
    "x-upgrade": true,
    "x-space": "available",
    "x-height": true,
    "x-example": "<lf-visual-review id=\"docs-review\" data-height=\"720\" source=\"docs-visual-run\"></lf-visual-review>"
  }
}
