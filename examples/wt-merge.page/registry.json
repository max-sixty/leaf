{
  "$data": {
    "description": "The moment a merge film shows, for the page that tells it.",
    "contracts": {
      "merge-frame": {
        "description": "The step a merge film is showing, its caption and the caption's tone, and how the run treats each step.",
        "schema": {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string"
            },
            "captionTone": {
              "enum": ["ink", "ok", "bad"]
            },
            "status": {
              "type": "object",
              "additionalProperties": {
                "enum": ["run", "skip", "fail", "unreached"]
              }
            }
          },
          "required": ["chapter", "caption", "captionTone", "status"],
          "additionalProperties": false
        }
      }
    }
  },
  "lf-merge-film": {
    "description": "An animated, scrubbable film of worktrunk's wt merge, drawn as one SVG in the page's colours, with flags that re-plot the run. Its commits, refs, worktrees and hook chips are commentable visual parts while they are on screen. It holds the moment it shows as its `frame` output, and a `--seek` command holds the result of the step its button's value names.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      }
    },
    "required": ["id"],
    "additionalProperties": false,
    "x-content": "empty",
    "x-output": {
      "frame": {
        "contract": "merge-frame"
      }
    },
    "x-upgrade": true,
    "x-visual": {
      "prefixes": ["commit:", "ref:", "tree:", "hook:"]
    },
    "x-space": "available"
  },
  "lf-merge-steps": {
    "description": "The steps of a merge film, told beside it. Its content is one authored <ol>: an <li> per step, each with an <h3> holding a <button commandfor=\"FILM\" command=\"--seek\" value=\"STEP\"> that names the film's step, a <p> saying what the step does, and an empty <p class=\"this-run\">. The module draws the `frame` output of the film named by `for`: it marks the step playing and how this run treats each step, and fills this-run with why a step was skipped or stopped.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "for": {
        "type": "string"
      }
    },
    "required": ["id", "for"],
    "additionalProperties": false,
    "x-content": "markup",
    "x-data": {
      "frame": {
        "contract": "merge-frame",
        "reference": "for",
        "property": "frame"
      }
    },
    "x-refers": {
      "for": {}
    },
    "x-upgrade": true
  }
}
