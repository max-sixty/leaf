FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    LEAF_SITE_ROOT=/app/site

COPY pyproject.toml uv.lock ./
COPY skills/leaf ./skills/leaf
RUN uv sync --frozen --no-dev --group website

COPY .tmp/site ./site
COPY worker/server.py ./worker/server.py

EXPOSE 8080
CMD ["/app/.venv/bin/python", "/app/worker/server.py"]
