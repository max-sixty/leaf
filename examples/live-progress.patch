diff --git a/services/checkout/refunds.py b/services/checkout/refunds.py
index 83da1c2..1de44a7 100644
--- a/services/checkout/refunds.py
+++ b/services/checkout/refunds.py
@@ -41,4 +41,13 @@ def apply_refund(order, adjustment):
-    order.state = "refunded"
-    order.refunded_minor = adjustment.amount
-    ledger.write(order)
-    return order
+    order.refunded += adjustment.amount
+    order.state = (
+        "refunded"
+        if order.refunded == order.total
+        else "partially_refunded"
+    )
+    ledger.write(order)
+    finance_export.write_adjustment(
+        order_id=order.id,
+        amount=adjustment.amount,
+        state=order.state,
+    )
+    return order
