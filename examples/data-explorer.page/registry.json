{
  "$data": {
    "contracts": {
      "data-explorer-values": {
        "description": "The release query playground with one page-owned aggregate configuration.",
        "schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "minimum": 1,
              "maximum": 6
            },
            "filters": {
              "type": "object",
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^filter-[1-9][0-9]*$"
                      },
                      "field": {
                        "enum": ["region", "risk", "owner"]
                      },
                      "operator": {
                        "enum": ["is", "above", "contains"]
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": ["id", "field", "operator", "value"],
                    "additionalProperties": false
                  }
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^filter-[1-9][0-9]*$"
                  }
                }
              },
              "required": ["rows", "order"],
              "additionalProperties": false
            }
          },
          "required": ["limit", "filters"],
          "additionalProperties": false
        }
      }
    }
  }
}
