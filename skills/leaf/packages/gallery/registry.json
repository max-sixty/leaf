{
  "lf-margin-entry-gallery": {
    "description": "The developer gallery's exhibit of page-edge action controls, disclosure controls, and status indicators across every rank, tone, face, agent workflow stage, user interaction state, and compact-to-Page-Map projection. It renders canonical controls through the runtime's margin-entry helpers; its live specimens change only local exhibit state and record no gestures. Use it only in the feature gallery; ordinary pages demonstrate these states through the live widgets that own them.",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false,
    "x-content": "empty",
    "x-exhibit": true,
    "x-upgrade": true,
    "x-example": "<lf-margin-entry-gallery id=\"margin-entry-gallery\"></lf-margin-entry-gallery>"
  },
