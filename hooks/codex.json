{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^resume$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" hook --harness codex || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" hook --harness codex || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" hook --harness codex || exit 1",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" hook --harness codex || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" hook --harness codex || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/leaf\" session-end || exit 1",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
