{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "ESNext.TypedArrays",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false
  },
  "include": [
    "*.d.ts",
    "../../dev/browser-globals.d.ts",
    "../../dev/leaf_dev/**/*.js",
    "domain.test.js",
    "../runtime/**/*.js",
    "../runtime/**/*.ts"
  ]
}
