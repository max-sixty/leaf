{
  "modules": ["./claude-code.ts"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^resume$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "exec python3 \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/loop-guard.py\" hook --harness claude-code --watch",
            "asyncRewake": true,
            "rewakeMessage": "Leaf:",
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" hook --harness claude-code || exit 1",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/leaf\" session-end || exit 1",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
