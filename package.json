{
  "name": "leaf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./hooks/pi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build:browser": "node build/browser/build.mjs",
    "check:browser": "node build/browser/build.mjs --check",
    "test:browser": "node --test build/browser/*.test.mjs build/*.test.mjs .github/scripts/*.test.mjs",
    "test:runtime": "node --import ./tests/runtime/dom.mjs --test tests/runtime/*.test.mjs",
    "fuzz:editor": "LEAF_FUZZ_DRAFTS=${LEAF_FUZZ_DRAFTS:-100000} node --import ./tests/runtime/dom.mjs --test --test-name-pattern='keep their promises' tests/runtime/field-editor.test.mjs",
    "check:framework": "pnpm run check:browser && pnpm run test:browser",
    "check:worker": "tsc --noEmit --project worker/tsconfig.json && pnpm run test:worker",
    "check:hooks": "tsc --project hooks/tsconfig.json && claude plugin validate .",
    "check:tools": "tsc --project build/tsconfig.json",
    "check": "pnpm run check:hooks && pnpm run check:tools && pnpm run check:framework && pnpm run test:runtime && pnpm run check:worker",
    "test:worker": "vitest run --root worker",
    "test:evals": "node --test dev/tests/node/*.cjs",
    "eval:legibility": "uv run leaf-dev probe release-notes --journey evals/control-legibility/views.py && PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1 promptfoo eval -c evals/control-legibility/promptfooconfig.yaml -o .tmp/control-legibility/results.json",
    "eval:ui-review": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1 promptfoo eval -c evals/ui-review-detection/promptfooconfig.mjs --filter-providers 'sol/(no-tools|browser)$'",
    "eval:root-guidance": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1 promptfoo eval -c evals/root-guidance/promptfooconfig.mjs",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE_CHECK=1 promptfoo view -y",
    "site:dev": "uv run leaf-dev site build && wrangler dev --config worker/wrangler.toml",
    "deploy:dev": "worker/deploy-dev.sh"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "@anthropic-ai/claude-code": "2.1.331",
    "@awesome.me/webawesome": "3.15.0",
    "@cloudflare/workers-types": "5.20261124.1",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7bff56b",
    "@eslint/js": "10.0.1",
    "@floating-ui/dom": "1.8.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@lezer/common": "1.5.6",
    "@lezer/highlight": "1.2.5",
    "@lit-labs/preact-signals": "1.0.3",
    "@observablehq/plot": "0.6.19",
    "@openai/codex-sdk": "0.172.0",
    "@pierre/diffs": "1.7.1",
    "@pierre/trees": "1.0.0",
    "@preact/signals-core": "1.14.5",
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@types/d3": "7.4.3",
    "@types/density-clustering": "1.3.3",
    "@types/json-schema": "7.0.15",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/sortablejs": "1.15.9",
    "@zumer/snapdom": "3.8.3",
    "acorn": "8.19.0",
    "d3": "7.9.2",
    "density-clustering": "1.3.0",
    "diff": "9.0.0",
    "dompurify": "3.5.0",
    "effect": "4.1.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eventsource-parser": "4.1.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "lightningcss": "1.33.0",
    "lit": "3.3.3",
    "lit-html": "3.3.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "modern-tar": "0.8.6",
    "oxc-parser": "0.160.0",
    "oxfmt": "0.79.0",
    "parse5": "8.1.1",
    "pele": "1.13.0",
    "photoswipe": "5.4.4",
    "playwright": "1.65.1",
    "promptfoo": "0.126.0",
    "rolldown": "1.2.14",
    "smol-toml": "1.9.1",
    "sortablejs": "1.15.7",
    "temml": "0.14.0",
    "typescript": "7.0.2",
    "viewerjs": "1.15.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@openai/codex": "0.172.0"
  },
  "packageManager": "pnpm@12.23.0"
}
